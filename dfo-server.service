[Unit]
Description=S4A21 Game Server (DfoServer)
After=network.target
Before=gateway.service

[Service]
Type=simple
User=msp
WorkingDirectory=/opt/S4A21Server/publish
ExecStart=/opt/S4A21Server/publish/DfoServer
Restart=on-failure
RestartSec=10
LimitNOFILE=65535
Environment=DOTNET_ENVIRONMENT=Production
Environment=PVF_ARCHIVE_PATH=/opt/S4A21Server/publish/Data/Pvf

[Install]
WantedBy=multi-user.target
